{
	"name": "epicwp/bot-insight",
	"description": "Shows site owners how much server PHP time goes to which bots.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4",
		"maxmind-db/reader": "^1.11",
		"yahnis-elsts/plugin-update-checker": "^5.5"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2",
		"wp-phpunit/wp-phpunit": "^6.2 || ^7.0",
		"wp-coding-standards/wpcs": "^3",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"phpstan/phpstan": "^1.12",
		"phpstan/extension-installer": "^1.3",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"BotInsight\\": "src/"
		}
	},
	"config": {
		"platform": {
			"php": "7.4.33"
		},
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"analyse": "phpstan analyse --memory-limit=1G",
		"test:unit": "phpunit --testsuite unit",
		"test:integration": "phpunit --configuration phpunit-integration.xml.dist"
	}
}
